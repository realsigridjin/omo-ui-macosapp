{
  "name": "omo-ui-windows",
  "productName": "OmO UI Windows",
  "version": "0.1.4-win.4",
  "private": true,
  "description": "Windows desktop fork of OmO UI for the omo coding agent",
  "license": "MIT",
  "author": "sigridjineth",
  "contributors": ["JunesuChoi"],
  "homepage": "https://github.com/JunesuChoi/omo-ui-windows",
  "repository": { "type": "git", "url": "https://github.com/JunesuChoi/omo-ui-windows.git" },
  "type": "module",
  "main": "dist-electron/main.cjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p e2e/tsconfig.json --noEmit",
    "test": "vitest run",
    "smoke:bridge": "node scripts/build-electron.mjs && node dist-electron/smoke-bridge.cjs",
    "test:e2e": "npm run build && playwright test e2e/iphone-bridge.spec.ts e2e/mcp.spec.ts e2e/profile-picker.spec.ts e2e/attachments.spec.ts e2e/fake.spec.ts e2e/notices.spec.ts e2e/quit.spec.ts e2e/skills.spec.ts e2e/omo-live.spec.ts e2e/shell.spec.ts e2e/btw.spec.ts e2e/long-conversation.spec.ts e2e/sidebar-filters.spec.ts e2e/stuck-turn.spec.ts e2e/theme-transition.spec.ts e2e/working-status.spec.ts e2e/dag.spec.ts e2e/edit-reroll.spec.ts e2e/omo-update.spec.ts e2e/accounts.spec.ts e2e/proxy.spec.ts e2e/workspace.spec.ts e2e/app-update.spec.ts e2e/model-routing.spec.ts",
    "test:e2e:real": "npm run build && node scripts/e2e-real.mjs",
    "package:mac": "npm run build && electron-builder --mac --arm64",
    "package:mac:dir": "npm run build && electron-builder --mac --arm64 --dir",
    "package:win": "npm run build && electron-builder --win --x64",
    "package:win:dir": "npm run build && electron-builder --win --x64 --dir",
    "install:app": "bash scripts/install-app.sh",
    "icon": "node scripts/render-icon.mjs",
    "screenshots": "npm run build && node scripts/readme-media.mjs",
    "postinstall": "node node_modules/electron/install.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@shikijs/langs": "^4.3.1",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.20.4",
    "@types/react": "~18.3.31",
    "@types/react-dom": "~18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "anser": "^2.3.5",
    "clsx": "^2.0.0",
    "diff": "^9.0.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "immer": "^10.1.1",
    "json5": "^2.2.3",
    "katex": "^0.16.47",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "micromark-core-commonmark": "^2.0.3",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "micromark-factory-space": "^2.0.1",
    "micromark-util-character": "^2.1.1",
    "micromark-util-classify-character": "^2.0.1",
    "micromark-util-sanitize-uri": "^2.0.1",
    "micromark-util-symbol": "^2.0.1",
    "micromark-util-types": "^2.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shiki": "^4.3.1",
    "simple-icons": "16.31.0",
    "typescript": "^6.0.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.8",
    "zustand": "~4.4.7"
  }
}
